ista general<\u002Fbutton><\u002Fdiv>\n<div id=\"faucetPanel\" style=\"display:none;flex-direction:column;gap:8px;padding:12px;background:#fff;border:1px solid #bbb;border-radius:8px;max-width:260px\">\n<div style=\"font-weight:600\">Botones de la grifería<\u002Fdiv>\n<div style=\"display:flex;flex-direction:column;gap:6px\">\n<button id=\"gStop\" style=\"display:flex;align-items:center;gap:10px;padding:10px;border:1px solid #999;border-radius:6px;cursor:pointer;font:inherit;background:#fff;color:#222;text-align:left\"><span style=\"width:12px;height:12px;border-radius:50%;background:#1b1c1f;flex:none\"><\u002Fspan>Parar el agua<\u002Fbutton>\n<button id=\"gSpray\" style=\"display:flex;align-items:center;gap:10px;padding:10px;border:1px solid #999;border-radius:6px;cursor:pointer;font:inherit;background:#fff;color:#222;text-align:left\"><span style=\"width:12px;height:16px;border-radius:6px 6px 2px 2px;background:#1b1c1f;flex:none\"><\u002Fspan>Lluvia<\u002Fbutton>\n<button id=\"gJet\" style=\"display:flex;align-items:center;gap:10px;padding:10px;border:1px solid #999;border-radius:6px;cursor:pointer;font:inherit;background:#fff;color:#222;text-align:left\"><span style=\"width:12px;height:16px;border-radius:2px 2px 6px 6px;background:#1b1c1f;flex:none\"><\u002Fspan>Chorro<\u002Fbutton><\u002Fdiv>\n<button id=\"gBack\" style=\"padding:8px;border:1px solid #ccc;border-radius:6px;cursor:pointer;font:inherit;background:#f4f4f4;color:#222\">Volver a la vista general<\u002Fbutton><\u002Fdiv><\u002Fdiv>\n<script type=\"text/plain\" id=\"logoData\">data:image/png;base64,<\u002Fscript>\n<three-d-stage name=\"fregadero-FRE-1000\" background=\"#d6d6d4\"><\u002Fthree-d-stage>\n<script src=\"d51f4700-c4f4-4d3d-a271-e24f5929a2bc\"><\u002Fscript>\n<script type=\"module\">\nconst stage=document.querySelector('three-d-stage');\nconst {THREE}=await stage.ready;\n{const ec=document.createElement('canvas');ec.width=512;ec.height=256;const ex=ec.getContext('2d');const gr=ex.createLinear